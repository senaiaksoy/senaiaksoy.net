              "credentialCategory": "license",
              "identifier": "ST-1008",
              "recognizedBy": { "@type": "GovernmentOrganization", "name": "T.C. Sağlık Bakanlığı" }
            }
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "+90-553-277-77-22",
            "email": "dr@senaiaksoy.net",
            "contactType": "patient inquiries",
            "availableLanguage": "Turkish"
          },
          "workLocation": {
            "@type": "MedicalClinic",
            "@id": "https://senaiaksoy.net/#clinic",
            "name": "Dr. Senai Aksoy IVF Clinic — Lotus Nişantaşı",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "Halaskargazi Cad. No:38-66, Kat:5, Ofis:92",
              "postalCode": "34371",
              "addressLocality": "Şişli",
              "addressRegion": "İstanbul",
              "addressCountry": "TR"
            }
          }
        }
      ]
    })} />


    <!-- Google Analytics - yalnızca onay verildiğinde yüklenir -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }

      if (localStorage.getItem('cookie-consent') === 'accepted') {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-LT5CQ05S1E';
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', 'G-LT5CQ05S1E');
      }
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
