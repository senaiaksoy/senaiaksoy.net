---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Dr. Senai Aksoy - Kadın Hastalıkları ve Doğum Uzmanı" } = Astro.props;

// Tekil kanonik host: her sayfa kendi kanonik URL'sini bildirir (www/apex + http/https
// kopyalarını önler). Astro.url.pathname yerine site origin'i sabitlenir.
const canonicalURL = new URL(Astro.url.pathname, 'https://senaiaksoy.net').href.replace(/\/$/, '') || 'https://senaiaksoy.net/';
const canonical = canonicalURL === 'https://senaiaksoy.net' ? 'https://senaiaksoy.net/' : canonicalURL;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="all" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preload" as="font" href="/fonts/inter.woff2" type="font/woff2" crossorigin />
    <link rel="preload" as="font" href="/fonts/playfair.woff2" type="font/woff2" crossorigin />
    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://senaiaksoy.net/#website",
          "url": "https://senaiaksoy.net/",
          "name": "Doç. Dr. Senai Aksoy",
          "inLanguage": "tr-TR",
          "publisher": { "@id": "https://senaiaksoy.net/#person" }
        },
        {
          "@type": "Person",
          "@id": "https://senaiaksoy.net/#person",
          "name": "Doç. Dr. Senai Aksoy",
          "givenName": "Senai",
          "familyName": "Aksoy",
          "honorificPrefix": "Doç. Dr.",
          "jobTitle": "Üreme Endokrinolojisi ve İnfertilite Uzmanı",
          "description": "Doç. Dr. Senai Aksoy — kadın hastalıkları, doğum ve üreme tıbbı uzmanı. Sevgi Hospital'in kurucu ICSI ekibi üyesi (1994-95), 30+ yıl deneyim.",
          "url": "https://senaiaksoy.net/",
          "email": "dr@senaiaksoy.net",
          "telephone": "+90-553-277-77-22",
          "knowsLanguage": ["tr", "fr", "en"],
          "sameAs": [
            "https://orcid.org/0000-0003-4110-5290",
            "https://www.wikidata.org/wiki/Q139893832",
            "https://pubmed.ncbi.nlm.nih.gov/?term=Aksoy%2C+Senai%5BAuthor%5D",
            "https://scholar.google.com.tr/scholar?hl=tr&as_sdt=0%2C5&q=senai+aksoy&btnG=",
            "https://www.linkedin.com/in/senai-aksoy-bba69b36/",
            "https://www.instagram.com/drsenaiaksoy/",
            "https://www.youtube.com/@DocentDrSenaiAksoy",
            "https://www.youtube.com/@SenaiAksoy",
            "https://draksoyivf.com/",
            "https://tupbebek.com/",
            "https://estranova.com/"
          ],
          "identifier": {
            "@type": "PropertyValue",
            "propertyID": "TR-Tabip-Sicil",
            "value": "39159"
          },
          "hasCredential": [
            {
              "@type": "EducationalOccupationalCredential",
              "name": "Türkiye Cumhuriyeti Tabip Sicil No",
              "credentialCategory": "license",
              "identifier": "39159",
              "recognizedBy": { "@type": "Organization", "name": "Türk Tabipleri Birliği" }
            },
            {
              "@type": "EducationalOccupationalCredential",
